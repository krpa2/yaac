CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Faster boot: on battery, PWR must be held until board_power_init() latches the power
CONFIG_SPIRAM_MEMTEST=n
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# ESP-SR recommends the large caches
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ESP-SR: wake word "Hey GiGi" (wn9l_heygigi), models in the "model" partition.
# Loaded from yaac/models through the external-model path: in esp-sr 2.5.5 the Kconfig
# option CONFIG_SR_WN_WN9L_HEYGIGI_TTS3 maps to a folder name that does not exist
# (wn9l_heygigi_tts3 vs wn9l_heygigi), so the model would silently not be packed.
# Absolute path: movemodel.py does not resolve it relative to the project.
CONFIG_MODEL_IN_FLASH=y
CONFIG_ESP_SR_EXTERNAL_MODEL_PATH="C:/repos/AL Display/yaac/models"
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_NONE=y

# Wi-Fi: let Wi-Fi/LWIP buffers use PSRAM so internal RAM stays free for the AFE
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Diagnostics: task list + run-time stats for the heartbeat
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
# Primary console on the USB Serial/JTAG port (UART0 pins 43/44 are not wired to USB)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Gemini Live (TLS WebSocket): mbedTLS buffers in PSRAM, internal RAM is nearly full
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
